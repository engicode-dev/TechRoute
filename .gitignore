# ==========================================
# Python (Виртуальное окружение и кэш)
# ==========================================
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.Pytest/

# ==========================================
# Личные данные и настройки
# ==========================================
# Файл с твоим ФИО, организацией и путями сохранения
data/user_settings.json

# ==========================================
# Сгенерированные файлы (результаты работы программы)
# ==========================================
# Файлы Excel, которые создает программа
*.xlsx
# Файлы PDF, которые создает программа
*.pdf
# Временные файлы LibreOffice
~$*.xlsx
~$*.pdf

# ==========================================
# Настройки IDE (PyCharm, VS Code)
# ==========================================
.idea/
.vscode/
*.iml

# ==========================================
# Системный мусор (Linux, Mac, Windows)
# ==========================================
.DS_Store
Thumbs.db
*.log